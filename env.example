# Chatbot AI (optional - chatbot uses keyword fallback responses if AI_API_KEY is empty)
# Free Groq API key: https://console.groq.com/keys
AI_API_KEY=
# Optional overrides for any OpenAI-compatible provider (defaults shown)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b

# MySQL Database Configuration
# For local development, you can use a local MySQL server or Railway's MySQL service
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=portfolio
DB_PORT=3306

# Required in production: signs admin session cookies (32+ random characters)
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Creates the first admin account on startup if none exists (password 12+ characters)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Project photos & uploads: defaults to ./public/uploads locally.
# On Railway, add a volume and set one of these so files survive redeploys:
# RAILWAY_VOLUME_MOUNT_PATH=/data
# Or set an absolute uploads directory:
# UPLOADS_ROOT=/data